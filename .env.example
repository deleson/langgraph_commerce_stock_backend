# App
# 应用基础配置，影响服务名称、运行环境、监听地址和日志。
# 应用名称，仅用于日志、文档和健康检查展示。
APP_NAME=LangGraph Commerce Backend
# 应用版本号，便于排查当前运行代码版本。
APP_VERSION=0.1.0
# 运行环境标识，常见值为 dev / test / production。
APP_ENV=dev
# 是否开启调试模式，生产环境必须为 false。
APP_DEBUG=true
# FastAPI 监听地址；Docker 生产环境通常使用 0.0.0.0。
APP_HOST=127.0.0.1
# FastAPI 容器内监听端口，Nginx 会代理到该端口。
APP_PORT=8000
# API v1 统一前缀，当前路由挂载在 /api/v1。
API_V1_PREFIX=/api/v1
# 应用日志级别，常用 INFO / DEBUG / WARNING。
APP_LOG_LEVEL=INFO

# Database
# 数据库连接池配置，API 主链路使用 DATABASE_ASYNC_URL。
# 同步 SQLAlchemy 数据库连接串，主要供 Alembic 或同步场景使用。
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/langgraph_commerce
# 异步 SQLAlchemy AsyncSession 数据库连接串，API 和 Service 主链路使用。
DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/langgraph_commerce
# 是否打印 SQL 日志，排查 SQL 时可临时开启。
DATABASE_ECHO=false
# 连接池取连接前是否探活，生产建议开启。
DATABASE_POOL_PRE_PING=true
# 数据库连接池基础连接数。
DATABASE_POOL_SIZE=5
# 连接池额外可临时创建的连接数。
DATABASE_MAX_OVERFLOW=10
# 从连接池获取连接的最长等待秒数。
DATABASE_POOL_TIMEOUT_SECONDS=30

# PostgreSQL Docker Service
# 仅 Docker Compose 初始化 PostgreSQL 服务时使用，本地直连也可保留一致。
# Docker Compose 中 PostgreSQL 服务初始化用户名。
POSTGRES_USER=postgres
# Docker Compose 中 PostgreSQL 服务初始化密码，生产不能使用弱密码。
POSTGRES_PASSWORD=postgres
# Docker Compose 中 PostgreSQL 服务初始化数据库名。
POSTGRES_DB=langgraph_commerce

# Redis and Celery
# Redis、Celery Worker 和 Celery Beat 的基础配置。
# 业务缓存 Redis 连接，一般使用 DB 0。
REDIS_URL=redis://127.0.0.1:6379/0
# Celery Broker 连接，Worker 从这里接收任务，一般使用 Redis DB 1。
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# Celery 结果后端连接，一般使用 Redis DB 2。
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# Celery 默认队列名称。
CELERY_TASK_DEFAULT_QUEUE=default
# Celery Beat 定时任务时区，国内部署使用 Asia/Shanghai。
CELERY_TIMEZONE=Asia/Shanghai
# Celery 是否用 UTC 存储和调度时间。
CELERY_ENABLE_UTC=true
# 是否记录任务 started 状态，便于后台任务追踪。
CELERY_TASK_TRACK_STARTED=true
# Celery 单任务硬超时时间，超时会被强制终止。
CELERY_TASK_TIME_LIMIT_SECONDS=1800
# Celery 单任务软超时时间，业务可在软超时前清理。
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=1500
# Celery 任务结果在结果后端中的保留秒数。
CELERY_RESULT_EXPIRES_SECONDS=3600
# Celery Beat 总开关；只有它开启，下面各组定时任务才可能加入 schedule。
CELERY_BEAT_ENABLED=false

# Celery Beat - Market Data Sync
# 定时任务组：scheduled-market-data-sync。
# Celery task: background_tasks.submit_scheduled_market_data_sync。
# 内部方法：_submit_scheduled_market_data_sync_async，创建 market_data_sync 后台任务，最终由 MarketDataSyncService.sync_candles 执行。
# 行情 K 线同步定时任务开关；对应 schedule: scheduled-market-data-sync。
CELERY_BEAT_MARKET_DATA_SYNC_ENABLED=false
# 行情 K 线同步间隔秒数；传给 build_beat_schedule 的 schedule(run_every=...)。
CELERY_BEAT_MARKET_DATA_SYNC_INTERVAL_SECONDS=86400
# 定时同步的股票代码；由 _submit_scheduled_market_data_sync_async 写入 MarketDataSyncTaskPayload.symbol。
CELERY_BEAT_MARKET_DATA_SYNC_SYMBOL=AAPL
# 定时同步的市场；写入 MarketDataSyncTaskPayload.market。
CELERY_BEAT_MARKET_DATA_SYNC_MARKET=US
# 定时同步的 K 线周期；写入 MarketDataSyncTaskPayload.timeframe。
CELERY_BEAT_MARKET_DATA_SYNC_TIMEFRAME=1d
# 定时同步的 K 线数量；写入 MarketDataSyncTaskPayload.limit。
CELERY_BEAT_MARKET_DATA_SYNC_LIMIT=30
# 定时同步复权类型；写入 MarketDataSyncTaskPayload.adjust_type。
CELERY_BEAT_MARKET_DATA_SYNC_ADJUST_TYPE=none
# 定时同步数据来源标记；写入 MarketDataSyncTaskPayload.source，实际同步由 MarketDataSyncService 执行。
CELERY_BEAT_MARKET_DATA_SYNC_SOURCE=mock

# Celery Beat - Market Symbol Sync
# 定时任务组：scheduled-market-symbol-sync。
# Celery task: background_tasks.submit_scheduled_market_symbol_sync。
# 内部方法：_submit_scheduled_market_symbol_sync_async，直接调用 MarketSymbolSyncService.sync_symbol_pool，只同步股票基础信息，不同步全市场 K 线。
# 股票基础信息池同步定时任务开关；对应 schedule: scheduled-market-symbol-sync。
CELERY_BEAT_MARKET_SYMBOL_SYNC_ENABLED=false
# 股票基础信息池同步间隔秒数；传给 build_beat_schedule 的 schedule(run_every=...)。
CELERY_BEAT_MARKET_SYMBOL_SYNC_INTERVAL_SECONDS=86400
# 同步哪个市场的股票基础信息；传给 MarketSymbolSyncService.sync_symbol_pool(market=...)。
CELERY_BEAT_MARKET_SYMBOL_SYNC_MARKET=CN
# 股票基础信息同步数量上限；留空表示全量拉取，生产建议留空。
CELERY_BEAT_MARKET_SYMBOL_SYNC_LIMIT=
# 股票池同步 Provider；传给 MarketSymbolSyncService(provider_name=...)，生产通常用 tushare。
CELERY_BEAT_MARKET_SYMBOL_SYNC_PROVIDER=

# Celery Beat - Watchlist Candle Sync
# 定时任务组：scheduled-watchlist-candle-sync。
# Celery task: background_tasks.submit_scheduled_watchlist_candle_sync。
# 只扫描去重后的自选股日 K 线，不执行全市场 K 线同步。
CELERY_BEAT_WATCHLIST_CANDLE_SYNC_ENABLED=false
# Asia/Shanghai 时区下每天 01:00 执行。
CELERY_BEAT_WATCHLIST_CANDLE_SYNC_HOUR=1
CELERY_BEAT_WATCHLIST_CANDLE_SYNC_MINUTE=0
CELERY_BEAT_WATCHLIST_CANDLE_SYNC_MARKET=CN
CELERY_BEAT_WATCHLIST_CANDLE_SYNC_TIMEFRAME=1d
# 每只股票拉取数量；满足指标和纸面交易所需窗口。
CELERY_BEAT_WATCHLIST_CANDLE_SYNC_LIMIT=120
CELERY_BEAT_WATCHLIST_CANDLE_SYNC_ADJUST_TYPE=none
# BaoStock 为主，Tushare 仅在主 Provider 失败时兜底。
CELERY_BEAT_WATCHLIST_CANDLE_SYNC_SOURCE=baostock
CELERY_BEAT_WATCHLIST_CANDLE_SYNC_FALLBACK_SOURCES=tushare
CELERY_BEAT_WATCHLIST_CANDLE_SYNC_MAX_SYMBOLS=300
CELERY_BEAT_WATCHLIST_CANDLE_SYNC_BATCH_SIZE=50
# 设为 0 表示每天都尝试刷新；重复 K 线通过 upsert 保持幂等。
CELERY_BEAT_WATCHLIST_CANDLE_SYNC_STALE_AFTER_DAYS=0
CELERY_BEAT_WATCHLIST_CANDLE_SYNC_MAX_RETRIES=2

# Celery Beat - Daily Report
# 定时任务组：scheduled-daily-reports。
# Celery task: background_tasks.submit_scheduled_daily_reports。
# 内部方法：_submit_scheduled_daily_reports_async，按用户分页创建 daily_report 后台任务，单用户任务最终复用 DailyReportQueryService.generate_daily_report。
# 每日简报定时任务开关；对应 schedule: scheduled-daily-reports。
CELERY_BEAT_DAILY_REPORT_ENABLED=false
# 每日简报触发小时；传给 crontab(hour=...)。
CELERY_BEAT_DAILY_REPORT_HOUR=18
# 每日简报触发分钟；传给 crontab(minute=...)。
CELERY_BEAT_DAILY_REPORT_MINUTE=0
# 是否在日报生成中启用 AI 润色；写入 DailyReportTaskPayload.use_ai。
CELERY_BEAT_DAILY_REPORT_USE_AI=true
# 是否强制重建当日日报；写入 DailyReportTaskPayload.force_rebuild。
CELERY_BEAT_DAILY_REPORT_FORCE_REBUILD=false
# 日报生成后是否通知用户；写入 DailyReportTaskPayload.notify。
CELERY_BEAT_DAILY_REPORT_NOTIFY=true
# 日报是否包含候选股票信息；写入 DailyReportTaskPayload.include_candidates。
CELERY_BEAT_DAILY_REPORT_INCLUDE_CANDIDATES=true
# 日报是否包含用户画像信息；写入 DailyReportTaskPayload.include_user_profile。
CELERY_BEAT_DAILY_REPORT_INCLUDE_USER_PROFILE=true
# 日报是否检索相关用户记忆；写入 DailyReportTaskPayload.include_relevant_memories。
CELERY_BEAT_DAILY_REPORT_INCLUDE_RELEVANT_MEMORIES=true
# 日报最多读取的自选股数量；写入 DailyReportTaskPayload.max_watchlist_items。
CELERY_BEAT_DAILY_REPORT_MAX_WATCHLIST_ITEMS=20
# 日报最多读取的候选股数量；写入 DailyReportTaskPayload.max_candidate_items。
CELERY_BEAT_DAILY_REPORT_MAX_CANDIDATE_ITEMS=5
# 每日简报批量扫描用户的分页大小；由 _submit_scheduled_daily_reports_async 使用。
CELERY_BEAT_DAILY_REPORT_BATCH_SIZE=200
# 每个日报后台任务最大重试次数；创建 background_tasks 记录时使用。
CELERY_BEAT_DAILY_REPORT_MAX_RETRIES=2

# Celery Beat - Quant Alert Scan
# 定时任务组：scheduled-quant-alert-scans。
# Celery task: background_tasks.submit_scheduled_alert_scans。
# 内部方法：_submit_scheduled_alert_scans_async，按用户分页创建 alert_scan 后台任务，单用户任务最终复用 QuantAlertQueryService.scan_alerts。
# 量化提醒扫描定时任务开关；对应 schedule: scheduled-quant-alert-scans。
CELERY_BEAT_QUANT_ALERT_SCAN_ENABLED=false
# 量化提醒扫描间隔秒数；传给 build_beat_schedule 的 schedule(run_every=...)。
CELERY_BEAT_QUANT_ALERT_SCAN_INTERVAL_SECONDS=900
# 扫描命中提醒后是否通知用户；写入 QuantAlertScanTaskPayload.notify。
CELERY_BEAT_QUANT_ALERT_SCAN_NOTIFY=true
# 是否强制扫描，绕过部分缓存或去重限制；写入 QuantAlertScanTaskPayload.force。
CELERY_BEAT_QUANT_ALERT_SCAN_FORCE=false
# 每个用户扫描的最大自选股数量；写入 QuantAlertScanTaskPayload.max_watchlist_items。
CELERY_BEAT_QUANT_ALERT_SCAN_MAX_WATCHLIST_ITEMS=100
# 量化提醒批量扫描用户的分页大小；由 _submit_scheduled_alert_scans_async 使用。
CELERY_BEAT_QUANT_ALERT_SCAN_BATCH_SIZE=200
# 每个量化提醒扫描后台任务最大重试次数；创建 background_tasks 记录时使用。
CELERY_BEAT_QUANT_ALERT_SCAN_MAX_RETRIES=2

# Celery Beat - Paper Trading Tick
# 定时任务组：scheduled-paper-trading-ticks。
# Celery task: background_tasks.submit_scheduled_paper_trading_ticks。
# 内部方法：_submit_scheduled_paper_trading_ticks_async，按用户分页创建 paper_trading_tick 后台任务，单用户任务最终复用 PaperTradingQueryService.run_tick。
# 纸面交易 tick 定时任务开关；对应 schedule: scheduled-paper-trading-ticks。
CELERY_BEAT_PAPER_TRADING_TICK_ENABLED=false
# 纸面交易 tick 触发小时；传给 crontab(hour=...)。
CELERY_BEAT_PAPER_TRADING_TICK_HOUR=20
# 纸面交易 tick 触发分钟；传给 crontab(minute=...)。
CELERY_BEAT_PAPER_TRADING_TICK_MINUTE=30
# tick 后是否通知用户；写入 PaperTradingTickTaskPayload.notify。
CELERY_BEAT_PAPER_TRADING_TICK_NOTIFY=false
# 是否强制推进模拟盘 tick；写入 PaperTradingTickTaskPayload.force。
CELERY_BEAT_PAPER_TRADING_TICK_FORCE=false
# 每个用户 tick 最多处理的股票数量；写入 PaperTradingTickTaskPayload.max_symbols。
CELERY_BEAT_PAPER_TRADING_TICK_MAX_SYMBOLS=50
# 纸面交易 tick 批量扫描用户的分页大小；由 _submit_scheduled_paper_trading_ticks_async 使用。
CELERY_BEAT_PAPER_TRADING_TICK_BATCH_SIZE=200
# 每个纸面交易 tick 后台任务最大重试次数；创建 background_tasks 记录时使用。
CELERY_BEAT_PAPER_TRADING_TICK_MAX_RETRIES=2

# JWT
# 认证和会话配置，影响登录、刷新 token、退出登录等接口。
# JWT 签名密钥，生产必须使用强随机值且不能泄露。
JWT_SECRET_KEY=change-this-in-production
# JWT 签名算法，当前使用 HS256。
JWT_ALGORITHM=HS256
# Access Token 有效分钟数。
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh Token 有效天数。
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Auth Session Policy
# 登录会话策略：控制同一账号在同类设备上是否只保留一个有效会话。
AUTH_SINGLE_SESSION_PER_DEVICE_CATEGORY_ENABLED=true
# unknown 设备类别是否参与同类设备互踢；旧客户端兼容期建议保持 false。
AUTH_SINGLE_SESSION_UNKNOWN_CATEGORY_ENABLED=false
# access token 鉴权时是否强制检查服务端 session 状态。
AUTH_ACCESS_TOKEN_SESSION_CHECK_ENABLED=true
# 同类设备新登录替换旧 session 时，是否把旧 access token jti 加入 Redis 黑名单。
AUTH_BLACKLIST_REPLACED_ACCESS_TOKEN=true

# LLM
# DeepSeek / OpenAI-compatible LLM 配置，供 AI 分析、日报 AI 润色等功能使用。
# DeepSeek API Key；生产和本地真实调用时填写，不能提交真实值。
DEEPSEEK_API_KEY=
# LLM Provider 名称，当前主链路为 deepseek。
LLM_PROVIDER=deepseek
# LLM 模型名称。
LLM_MODEL=deepseek-v4-flash
# OpenAI-compatible LLM 接口地址。
LLM_BASE_URL=https://api.deepseek.com
# LLM 采样温度，越低越稳定。
LLM_TEMPERATURE=0.3

# HTTP Client
# 外部 HTTP 客户端超时配置，Provider 和 LLM 调用会参考。
# 外部 HTTP 请求总超时时间。
HTTP_CLIENT_TIMEOUT_SECONDS=20
# 外部 HTTP 请求连接超时时间。
HTTP_CLIENT_CONNECT_TIMEOUT_SECONDS=5

# Market Data Provider
# 行情、K 线、overview、技术指标和策略信号的数据来源配置。
# 是否启用真实行情 Provider；false 时主要使用 mock。
MARKET_DATA_ENABLE_REAL_PROVIDER=false
# K 线和行情同步主 Provider；生产当前推荐 baostock。
MARKET_DATA_PRIMARY_PROVIDER=mock
# 行情 fallback Provider 配置预留，目前业务自动 fallback 链路未完整实现。
MARKET_DATA_FALLBACK_PROVIDERS=mock
# 默认市场代码。
MARKET_DATA_DEFAULT_MARKET=CN
# 默认 K 线周期。
MARKET_DATA_DEFAULT_TIMEFRAME=1d
# 手动或按需同步 K 线时的默认拉取数量。
MARKET_DATA_CANDLE_SYNC_LIMIT=250
# 报价缓存 TTL 秒数。
MARKET_DATA_QUOTE_CACHE_TTL_SECONDS=60
# 行情 Provider 请求超时时间。
MARKET_DATA_REQUEST_TIMEOUT_SECONDS=20
# 是否启用行情相关缓存。
MARKET_DATA_CACHE_ENABLED=true
# 股票 overview 聚合结果缓存 TTL 秒数。
MARKET_DATA_OVERVIEW_CACHE_TTL_SECONDS=60
# K 线查询缓存 TTL 秒数。
MARKET_DATA_CANDLES_CACHE_TTL_SECONDS=300
# 数据质量报告缓存 TTL 秒数。
MARKET_DATA_QUALITY_CACHE_TTL_SECONDS=300
# 行情同步状态缓存 TTL 秒数。
MARKET_DATA_SYNC_STATUS_CACHE_TTL_SECONDS=60
# 技术指标查询缓存 TTL 秒数。
MARKET_DATA_TECHNICAL_INDICATOR_CACHE_TTL_SECONDS=300

# Market Symbol Provider
# 股票基础信息 Provider 配置，影响 market_symbol_sources 和 market_symbols 的维护。
# 统一股票基础信息表的最高优先级 Provider，默认 tushare。
MARKET_SYMBOL_PRIMARY_PROVIDER=tushare
# 股票基础信息备用 Provider 优先级，逗号分隔。
MARKET_SYMBOL_FALLBACK_PROVIDERS=baostock,mock
# 股票基础信息池低频同步 Provider；为空时回退到 MARKET_DATA_PRIMARY_PROVIDER。
MARKET_SYMBOL_SYNC_PROVIDER=
# 用户搜索 6 位 A 股代码缺失时的精确补齐 Provider，默认 baostock。
MARKET_SYMBOL_EXACT_LOOKUP_PROVIDER=baostock

# BaoStock Provider
# BaoStock 主要用于 A 股 K 线同步和单只股票代码精确补齐。
# 是否允许构建 BaoStock Provider。
BAOSTOCK_ENABLED=true

# AKShare Provider
# AKShare 目前仅保留配置开关，当前 Provider 工厂未完整启用。
# AKShare 预留开关；当前 Provider 工厂未完整启用 AKShare。
AKSHARE_ENABLED=false

# Tushare Provider
# Tushare 主要用于低频股票基础信息池同步，额度宝贵，不应放进高频用户搜索链路。
# 是否允许构建 Tushare Provider；启用股票池同步时需要 true。
TUSHARE_ENABLED=false
# Tushare Token；只在后端保存，不能传给前端或提交真实值。
TUSHARE_TOKEN=

# Alpha Vantage Provider
# Alpha Vantage 预留配置，当前主链路未使用。
# Alpha Vantage 预留开关。
ALPHA_VANTAGE_ENABLED=false
# Alpha Vantage API Key 预留字段。
ALPHA_VANTAGE_API_KEY=
