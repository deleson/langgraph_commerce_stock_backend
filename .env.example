APP_NAME=LangGraph Commerce Backend
APP_VERSION=0.1.0
APP_ENV=dev
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_PREFIX=/api/v1
APP_LOG_LEVEL=INFO


DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/langgraph_commerce
DATABASE_ECHO=false
DATABASE_POOL_PRE_PING=true
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://127.0.0.1:6379/0
