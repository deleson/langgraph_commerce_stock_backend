APP_NAME=LangGraph Commerce Backend
APP_VERSION=0.1.0
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
APP_LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://langgraph_app:replace-with-strong-password@postgres:5432/langgraph_commerce
DATABASE_ASYNC_URL=postgresql+asyncpg://langgraph_app:replace-with-strong-password@postgres:5432/langgraph_commerce
DATABASE_ECHO=false
DATABASE_POOL_PRE_PING=true
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_TIMEZONE=Asia/Shanghai
CELERY_ENABLE_UTC=true
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT_SECONDS=1800
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=1500
CELERY_RESULT_EXPIRES_SECONDS=3600

CELERY_BEAT_ENABLED=false

CELERY_BEAT_MARKET_DATA_SYNC_ENABLED=false
CELERY_BEAT_MARKET_DATA_SYNC_INTERVAL_SECONDS=86400
CELERY_BEAT_MARKET_DATA_SYNC_SYMBOL=AAPL
CELERY_BEAT_MARKET_DATA_SYNC_MARKET=US
CELERY_BEAT_MARKET_DATA_SYNC_TIMEFRAME=1d
CELERY_BEAT_MARKET_DATA_SYNC_LIMIT=30
CELERY_BEAT_MARKET_DATA_SYNC_ADJUST_TYPE=none
CELERY_BEAT_MARKET_DATA_SYNC_SOURCE=akshare

CELERY_BEAT_DAILY_REPORT_ENABLED=false
CELERY_BEAT_DAILY_REPORT_HOUR=18
CELERY_BEAT_DAILY_REPORT_MINUTE=0
CELERY_BEAT_DAILY_REPORT_USE_AI=true
CELERY_BEAT_DAILY_REPORT_FORCE_REBUILD=false
CELERY_BEAT_DAILY_REPORT_NOTIFY=true
CELERY_BEAT_DAILY_REPORT_INCLUDE_CANDIDATES=true
CELERY_BEAT_DAILY_REPORT_INCLUDE_USER_PROFILE=true
CELERY_BEAT_DAILY_REPORT_INCLUDE_RELEVANT_MEMORIES=true
CELERY_BEAT_DAILY_REPORT_MAX_WATCHLIST_ITEMS=20
CELERY_BEAT_DAILY_REPORT_MAX_CANDIDATE_ITEMS=5
CELERY_BEAT_DAILY_REPORT_BATCH_SIZE=200
CELERY_BEAT_DAILY_REPORT_MAX_RETRIES=2

CELERY_BEAT_QUANT_ALERT_SCAN_ENABLED=false
CELERY_BEAT_QUANT_ALERT_SCAN_INTERVAL_SECONDS=900
CELERY_BEAT_QUANT_ALERT_SCAN_NOTIFY=true
CELERY_BEAT_QUANT_ALERT_SCAN_FORCE=false
CELERY_BEAT_QUANT_ALERT_SCAN_MAX_WATCHLIST_ITEMS=100
CELERY_BEAT_QUANT_ALERT_SCAN_BATCH_SIZE=200
CELERY_BEAT_QUANT_ALERT_SCAN_MAX_RETRIES=2

CELERY_BEAT_PAPER_TRADING_TICK_ENABLED=false
CELERY_BEAT_PAPER_TRADING_TICK_HOUR=20
CELERY_BEAT_PAPER_TRADING_TICK_MINUTE=30
CELERY_BEAT_PAPER_TRADING_TICK_NOTIFY=false
CELERY_BEAT_PAPER_TRADING_TICK_FORCE=false
CELERY_BEAT_PAPER_TRADING_TICK_MAX_SYMBOLS=50
CELERY_BEAT_PAPER_TRADING_TICK_BATCH_SIZE=200
CELERY_BEAT_PAPER_TRADING_TICK_MAX_RETRIES=2

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

DEEPSEEK_API_KEY=replace-with-your-real-deepseek-key
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.3

HTTP_CLIENT_TIMEOUT_SECONDS=20
HTTP_CLIENT_CONNECT_TIMEOUT_SECONDS=5

MARKET_DATA_ENABLE_REAL_PROVIDER=true
MARKET_DATA_PRIMARY_PROVIDER=akshare
MARKET_DATA_FALLBACK_PROVIDERS=mock
MARKET_DATA_DEFAULT_MARKET=CN
MARKET_DATA_DEFAULT_TIMEFRAME=1d
MARKET_DATA_CANDLE_SYNC_LIMIT=250
MARKET_DATA_QUOTE_CACHE_TTL_SECONDS=60
MARKET_DATA_REQUEST_TIMEOUT_SECONDS=20
MARKET_DATA_CACHE_ENABLED=true
MARKET_DATA_OVERVIEW_CACHE_TTL_SECONDS=60
MARKET_DATA_CANDLES_CACHE_TTL_SECONDS=300
MARKET_DATA_QUALITY_CACHE_TTL_SECONDS=300
MARKET_DATA_SYNC_STATUS_CACHE_TTL_SECONDS=60
MARKET_DATA_TECHNICAL_INDICATOR_CACHE_TTL_SECONDS=300

BAOSTOCK_ENABLED=true
AKSHARE_ENABLED=true

TUSHARE_ENABLED=false
TUSHARE_TOKEN=

ALPHA_VANTAGE_ENABLED=false
ALPHA_VANTAGE_API_KEY=