# 测试环境变量模板。
#
# pytest 会通过 APP_ENV_FILE=.env.test 读取本配置。
# 测试库必须是 langgraph_commerce_test，避免测试清库逻辑误伤开发库或生产库。

APP_NAME=LangGraph Commerce Backend Test
APP_VERSION=0.1.0
APP_ENV=test
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8001
API_V1_PREFIX=/api/v1
APP_LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/langgraph_commerce_test
DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/langgraph_commerce_test

DATABASE_ECHO=false
DATABASE_POOL_PRE_PING=true
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=30

REDIS_URL=redis://127.0.0.1:6379/10
CELERY_BROKER_URL=redis://127.0.0.1:6379/11
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/12
CELERY_TASK_DEFAULT_QUEUE=test
CELERY_BEAT_ENABLED=false
CELERY_BEAT_MARKET_DATA_SYNC_ENABLED=false
CELERY_BEAT_DAILY_REPORT_ENABLED=false
CELERY_BEAT_QUANT_ALERT_SCAN_ENABLED=false
CELERY_BEAT_PAPER_TRADING_TICK_ENABLED=false

JWT_SECRET_KEY=test-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 测试环境默认使用 mock LLM，不消耗真实 DeepSeek 额度。
DEEPSEEK_API_KEY=
LLM_PROVIDER=mock
LLM_MODEL=mock-llm
LLM_BASE_URL=http://127.0.0.1/mock
LLM_TEMPERATURE=0.0

HTTP_CLIENT_TIMEOUT_SECONDS=5
HTTP_CLIENT_CONNECT_TIMEOUT_SECONDS=2

# 测试环境默认使用 mock 行情，保证结果稳定可复现。
MARKET_DATA_ENABLE_REAL_PROVIDER=false
MARKET_DATA_PRIMARY_PROVIDER=mock
MARKET_DATA_FALLBACK_PROVIDERS=mock
MARKET_DATA_DEFAULT_MARKET=CN
MARKET_DATA_DEFAULT_TIMEFRAME=1d
MARKET_DATA_CANDLE_SYNC_LIMIT=250
MARKET_DATA_QUOTE_CACHE_TTL_SECONDS=1
MARKET_DATA_REQUEST_TIMEOUT_SECONDS=5
MARKET_DATA_CACHE_ENABLED=false
MARKET_DATA_OVERVIEW_CACHE_TTL_SECONDS=1
MARKET_DATA_CANDLES_CACHE_TTL_SECONDS=1
MARKET_DATA_QUALITY_CACHE_TTL_SECONDS=1
MARKET_DATA_SYNC_STATUS_CACHE_TTL_SECONDS=1
MARKET_DATA_TECHNICAL_INDICATOR_CACHE_TTL_SECONDS=1

BAOSTOCK_ENABLED=false
AKSHARE_ENABLED=false
TUSHARE_ENABLED=false
TUSHARE_TOKEN=
ALPHA_VANTAGE_ENABLED=false
ALPHA_VANTAGE_API_KEY=
